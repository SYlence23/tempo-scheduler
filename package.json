{
  "name": "tempo-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Schedule optimization with Python workers, a Python least-connections balancer and a PostgreSQL queue",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node backend/index.mjs",
    "worker": "node scripts/run-python.mjs worker",
    "balancer": "node scripts/run-python.mjs balancer",
    "autoscaler": "node scripts/run-python.mjs autoscaler",
    "supervisor": "node scripts/run-python.mjs supervisor",
    "db:init": "node backend/initialize.mjs",
    "test": "node scripts/test.mjs",
    "test:integration": "node --test test/integration.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "pg": "8.16.3"
  }
}
